{
	"name": "kode",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"lint": "next typegen && oxlint",
		"lint:fix": "next typegen && oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "next typegen && tsc --noEmit",
		"qa": "next typegen && oxlint && tsc --noEmit && vitest run",
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.17",
		"next": "16.4.6",
		"opentype.js": "2.0.0",
		"qrcode-generator": "^2.0.4",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/types": "^21.2.3",
		"@tailwindcss/turbopack": "4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"happy-dom": "^21.0.4",
		"jsqr": "^1.4.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"tailwindcss": "4.3.3",
		"typescript": "^7",
		"vitest": "^5",
		"wrangler": "^4.163.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "bun@1.4.4",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver",
		"workerd"
	]
}
