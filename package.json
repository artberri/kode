{
	"name": "kode",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"lint": "next typegen && oxlint",
		"lint:fix": "next typegen && oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "next typegen && tsc --noEmit",
		"check": "bun run format:check && bun run lint && bun run typecheck"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.17",
		"next": "16.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"tailwindcss": "4.3.3",
		"typescript": "^5",
		"wrangler": "^4.163.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "bun@1.4.4",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver",
		"workerd"
	]
}
