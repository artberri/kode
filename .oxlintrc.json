{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"react",
		"react-perf",
		"jsx-a11y",
		"nextjs",
		"promise",
		"vitest"
	],
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"options": {
		"typeAware": true,
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "error"
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"pedantic": "warn"
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/strict-boolean-expressions": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/prefer-nullish-coalescing": "error",
		"typescript/prefer-optional-chain": "error",
		"typescript/no-unnecessary-condition": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/return-await": ["error", "always"],
		"eqeqeq": "error",
		"no-console": "error",
		"import/no-cycle": "error",
		"react/react-in-jsx-scope": "off",
		"react/jsx-filename-extension": [
			"error",
			{
				"extensions": [".tsx"]
			}
		],
		"import/no-default-export": "off",
		"import/no-unassigned-import": [
			"error",
			{
				"allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
			}
		],
		"typescript/prefer-readonly-parameter-types": "off"
	},
	"ignorePatterns": [".next", ".open-next", ".wrangler", "next-env.d.ts", "cloudflare-env.d.ts"],
	"overrides": [
		{
			"files": ["src/*/domain/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"next",
									"next/*",
									"react",
									"react/*",
									"react-dom",
									"react-dom/*",
									"@opennextjs/*",
									"cloudflare:*",
									"@testing-library/*",
									"happy-dom"
								],
								"message": "domain is pure: no frameworks, no I/O, and no imports from application or infrastructure."
							},
							{
								"group": [
									"**/application",
									"**/application/**",
									"**/infrastructure",
									"**/infrastructure/**"
								],
								"message": "domain is pure: no frameworks, no I/O, and no imports from application or infrastructure."
							},
							{
								"group": ["@/**", "!@/shared", "!@/shared/**"],
								"message": "Slices stay independent: import your own slice with relative paths, and shared code from @/shared only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/*/application/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"next",
									"next/*",
									"react",
									"react/*",
									"react-dom",
									"react-dom/*",
									"@opennextjs/*",
									"cloudflare:*",
									"@testing-library/*",
									"happy-dom"
								],
								"message": "application depends only on domain and its own ports: no frameworks and no imports from infrastructure."
							},
							{
								"group": ["**/infrastructure", "**/infrastructure/**"],
								"message": "application depends only on domain and its own ports: no frameworks and no imports from infrastructure."
							},
							{
								"group": ["@/**", "!@/shared", "!@/shared/**"],
								"message": "Slices stay independent: import your own slice with relative paths, and shared code from @/shared only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/*/infrastructure/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@/**", "!@/shared", "!@/shared/**"],
								"message": "Slices stay independent: import your own slice with relative paths, and shared code from @/shared only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/shared/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@/**", "!@/shared", "!@/shared/**"],
								"message": "Shared code doesn't depend on any slice."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/**/*.test.ts", "src/**/*.test.tsx"],
			"rules": {
				"max-lines-per-function": "off",
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@/**", "!@/shared", "!@/shared/**"],
								"message": "Slices stay independent: import your own slice with relative paths, and shared code from @/shared only."
							}
						]
					}
				]
			}
		}
	]
}
