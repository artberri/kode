#!/usr/bin/env bash
# Formats staged files with oxfmt. Fully staged files are formatted and re-staged;
# files that also have unstaged changes are only checked, so the hook never stages
# work the user left out of the commit.
set -euo pipefail

oxfmt="node_modules/.bin/oxfmt"
if [[ ! -x "$oxfmt" ]]; then
	echo "pre-commit: oxfmt not found, run 'bun install' first." >&2
	exit 1
fi

fully_staged=()
partially_staged=()
while IFS= read -r -d '' file; do
	if git diff --quiet -- "$file"; then
		fully_staged+=("$file")
	else
		partially_staged+=("$file")
	fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#fully_staged[@]} -gt 0 ]]; then
	"$oxfmt" --no-error-on-unmatched-pattern -- "${fully_staged[@]}" >/dev/null
	git add -- "${fully_staged[@]}"
fi

if [[ ${#partially_staged[@]} -gt 0 ]]; then
	if ! "$oxfmt" --check --no-error-on-unmatched-pattern -- "${partially_staged[@]}"; then
		echo "pre-commit: these files are partially staged and not formatted." >&2
		echo "Run 'bun run format', stage the result, and commit again." >&2
		exit 1
	fi
fi
