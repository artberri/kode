{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kode",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The site is served only on kode.eus: deploying creates its DNS record and certificate.
	// www.kode.eus redirects to it through a zone redirect rule, see docs/DEPLOYMENT.md.
	"routes": [{ "pattern": "kode.eus", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
}
